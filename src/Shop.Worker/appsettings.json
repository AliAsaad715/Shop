{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "RabbitMq": {
    "Port": 5672,
    "VirtualHost": "/",
    "ConnectTimeout": "00:00:05",
    "ConfirmTimeout": "00:00:05"
  },
  "Email": {
    "Provider": "Mailpit",
    "From": "Shop <orders@shop.local>",
    "Timeout": "00:00:15",
    "Mailpit": {
      "Host": "localhost",
      "Port": 1025
    },
    "Smtp": {
      "Port": 587,
      "Security": "StartTls"
    }
  }
}
