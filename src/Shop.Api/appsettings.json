{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "LoginRateLimit": {
    "PermitLimit": 5,
    "WindowSeconds": 60
  },
  "Jwt": {
    "Issuer": "shop",
    "Audience": "shop-api",
    "LifetimeMinutes": 15
  },
  "Inventory": {
    "GetStockTimeout": "00:00:00.500",
    "ReserveTimeout": "00:00:02",
    "ReleaseTimeout": "00:00:02"
  }
}
