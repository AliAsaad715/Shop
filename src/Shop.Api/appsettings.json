{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CatalogCache": {
    "Enabled": true,
    "ProductTtl": "00:10:00",
    "CategoriesTtl": "01:00:00",
    "ListTtl": "00:01:00",
    "LocalTtl": "00:00:05",
    "MaxCachedPage": 3
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "LoginRateLimit": {
    "PermitLimit": 5,
    "WindowSeconds": 60
  },
  "Jwt": {
    "Issuer": "shop",
    "Audience": "shop-api",
    "LifetimeMinutes": 15
  },
  "Inventory": {
    "GetStockTimeout": "00:00:00.500",
    "ReserveTimeout": "00:00:02",
    "ReleaseTimeout": "00:00:02"
  }
}
