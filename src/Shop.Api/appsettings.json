{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "LoginRateLimit": {
    "PermitLimit": 5,
    "WindowSeconds": 60
  },
