<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Only SharedKernel and *.Contracts projects; never another module -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\Shop.SharedKernel\Shop.SharedKernel.csproj" />
    <ProjectReference Include="..\Shop.Modules.Products.Contracts\Shop.Modules.Products.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Net.ClientFactory" />
    <PackageReference Include="Grpc.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- The warehouse's shared contract. Grpc.Tools generates the client on every build; internal,
       so gRPC types stay behind IInventoryService and other modules never see them -->
  <ItemGroup>
    <Protobuf Include="..\..\..\..\contracts\inventory\v1\inventory.proto"
              ProtoRoot="..\..\..\..\contracts"
              GrpcServices="Client"
              Access="Internal"
              Link="Inventory\inventory.proto" />
  </ItemGroup>

  <!-- The placeholder the demo seeder copies into image storage for each demo product -->
  <ItemGroup>
    <EmbeddedResource Include="Seeding\demo-product.png" LogicalName="Shop.Modules.Products.Seeding.demo-product.png" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Shop.Modules.Products.IntegrationTests" />
  </ItemGroup>

</Project>
