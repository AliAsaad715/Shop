# Keep host build output, IDE state and secrets out of the build context;
# obj/ from a Windows build breaks the restore inside the Linux image
**/bin
**/obj
**/.vs
**/.vscode
**/.idea
**/*.user
**/TestResults
.git
.env
# Legacy development images are imported explicitly, never included in the API build context.
**/App_Data/images

# The Go warehouse builds from its own context (compose's inventory service), never the API image
warehouse
