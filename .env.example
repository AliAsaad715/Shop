# Copy to .env to override the defaults in compose.yaml
POSTGRES_DB=shop
POSTGRES_USER=shop
POSTGRES_PASSWORD=shop

# The admin account seeded on startup; change the password outside local demos
ADMIN_EMAIL=admin@shop.local
ADMIN_PASSWORD=Admin123!

# Required: a base64-encoded random key of at least 32 bytes. Do not commit your .env.
# PowerShell 7: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
JWT_SIGNING_KEY=

# Host ports. appsettings.Development.json expects Postgres on 5433, leaving 5432 to a local install
API_PORT=8080
POSTGRES_PORT=5433

# Production for demos; Development for local debugging
ASPNETCORE_ENVIRONMENT=Production
