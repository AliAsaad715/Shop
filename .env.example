# Copy to .env to override the defaults in compose.yaml
POSTGRES_DB=shop
POSTGRES_USER=shop
POSTGRES_PASSWORD=shop

# The admin account seeded on startup; change the password outside local demos
ADMIN_EMAIL=admin@shop.local
ADMIN_PASSWORD=Admin123!

# Required: a base64-encoded random key of at least 32 bytes. Do not commit your .env.
# PowerShell: $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
# Local dotnet run / Visual Studio: dotnet user-secrets set Jwt:SigningKey <key> --project src/Shop.Api
JWT_SIGNING_KEY=

# Per-IP login quota. Raise permits only for automated tests or scripted demos.
LOGIN_RATE_LIMIT_PERMIT_LIMIT=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# Exact frontend origin (scheme, host and port), without a trailing slash.
FRONTEND_ORIGIN=http://localhost:5173

# Host ports. appsettings.Development.json expects Postgres on 5433, leaving 5432 to a local install
API_PORT=8080
POSTGRES_PORT=5433

# Production for demos; Development for local debugging
ASPNETCORE_ENVIRONMENT=Production
