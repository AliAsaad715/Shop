# Copy to .env to override the defaults in compose.yaml
POSTGRES_DB=shop
POSTGRES_USER=shop
POSTGRES_PASSWORD=shop

# The admin account seeded on startup; change the password outside local demos
ADMIN_EMAIL=admin@shop.local
ADMIN_PASSWORD=Admin123!

# Adds six demo products on startup, matching the warehouse seed; false starts with an empty catalog
DEMO_SEED_ENABLED=true

# The warehouse's own database (inventory-db). Change the password outside local demos; changing any of
# these after the first run needs a fresh volume: docker compose down -v
INVENTORY_DB_NAME=inventory
INVENTORY_DB_USER=inventory
INVENTORY_DB_PASSWORD=inventory

# The warehouse's log level: debug, info, warn or error
INVENTORY_LOG_LEVEL=info

# Demos only: every warehouse call waits this many milliseconds first; above 2000 the app's deadlines
# fire. Keep 0 outside the slow-warehouse demo in tests/proof/README.md
INVENTORY_DELAY_MS=0

# Required: a base64-encoded random key of at least 32 bytes. Do not commit your .env.
# PowerShell 7: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
JWT_SIGNING_KEY=

# Per-IP login quota. Raise permits only for automated tests or scripted demos.
LOGIN_RATE_LIMIT_PERMIT_LIMIT=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# Exact frontend origin (scheme, host and port), without a trailing slash.
FRONTEND_ORIGIN=http://localhost:5173

# Host ports. appsettings.Development.json expects Postgres on 5433, leaving 5432 to a local install
API_PORT=8080
POSTGRES_PORT=5433

# Production for demos; Development for local debugging
ASPNETCORE_ENVIRONMENT=Production
