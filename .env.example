# Copy to .env to override the defaults in compose.yaml
POSTGRES_DB=shop
POSTGRES_USER=shop
POSTGRES_PASSWORD=shop

# The admin account created by migrator (--migrate-and-seed); change the password outside local demos
ADMIN_EMAIL=admin@shop.local
ADMIN_PASSWORD=Admin123!

# Migrator adds six demo products matching the warehouse seed; false skips the demo catalog
DEMO_SEED_ENABLED=true

# The warehouse's own database (inventory-db). Change the password outside local demos; changing any of
# these after the first run needs a fresh volume: docker compose down -v
INVENTORY_DB_NAME=inventory
INVENTORY_DB_USER=inventory
INVENTORY_DB_PASSWORD=inventory

# The warehouse's log level: debug, info, warn or error
INVENTORY_LOG_LEVEL=info

# Demos only: every warehouse call waits this many milliseconds first; above 2000 the app's deadlines
# fire. Keep 0 outside the slow-warehouse demo in tests/proof/README.md
INVENTORY_DELAY_MS=0

# Required: a base64-encoded random key of at least 32 bytes. Do not commit your .env.
# PowerShell 7: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
JWT_SIGNING_KEY=

# Per-IP login quota. Raise permits only for automated tests or scripted demos.
LOGIN_RATE_LIMIT_PERMIT_LIMIT=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# Exact frontend origin (scheme, host and port), without a trailing slash.
FRONTEND_ORIGIN=http://localhost:5173

# The Compose network and API trusted forwarding range use this same CIDR (R5-05).
# Changing an existing network requires `docker compose down` without -v, then `docker compose up -d --build --wait`.
SHOP_NETWORK_SUBNET=172.30.50.0/24

# Host ports. API_PORT is Nginx's, the only way into the three API instances (task R5-03). appsettings.Development.json
# expects Postgres on 5433, leaving 5432 to a local install
API_PORT=8080
POSTGRES_PORT=5433
REDIS_PORT=6379
REPLICA_PORT=5434
CATALOG_CACHE_ENABLED=true

# The read replica (task R3-10) runs only with its profile: docker compose --profile replica up -d --wait.
# COMPOSE_PROFILES=replica here starts it with every docker compose up
REPLICATION_PASSWORD=replicator
# Demos only: the replica replays every change this long after the primary made it, such as 5s (R3-11's
# stale-read demo). Keep 0 otherwise
REPLICA_APPLY_DELAY=0
READ_ROUTING_ENABLED=false
# Recent writers read the primary and bypass shared catalog caches for this long (R3-11).
READ_YOUR_WRITES_WINDOW=00:00:10

# RabbitMQ (task R4-01). The user is created only when its volume is empty, so after changing these run
# docker compose rm -sf rabbitmq && docker volume rm shop_rabbitmq-data. Change the password outside local demos
RABBITMQ_USER=shop
RABBITMQ_PASSWORD=shop
# Host ports, on localhost only: AMQP, and the management UI at http://localhost:15672
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

# Email (task R4-04). Mailpit catches every email; its inbox is at http://localhost:8025. To send for real, set
# EMAIL_PROVIDER=Smtp. For Gmail: turn on 2-Step Verification, create an app password (Google Account > Security >
# App passwords), and use your Gmail address as both SMTP_USER and the address in EMAIL_FROM. Keep k6 runs on Mailpit:
# their orders use made-up addresses, and Gmail blocks accounts that bounce many emails
EMAIL_PROVIDER=Mailpit
EMAIL_FROM=Shop <orders@shop.local>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=StartTls
SMTP_USER=
SMTP_PASSWORD=
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# Production for demos; Development for local debugging
ASPNETCORE_ENVIRONMENT=Production
